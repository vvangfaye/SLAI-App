.attendance-page { padding: 32rpx 28rpx 48rpx; }
.sync-button { margin: 0; padding: 0 24rpx; line-height: 64rpx; font-size: 23rpx; background: #386552; color: #fff; border-radius: 32rpx; }
.source-caption { color: #8b897d; font-size: 21rpx; margin-top: 18rpx; }
.month-summary { display: flex; padding: 30rpx 6rpx; margin: 8rpx 0 6rpx; }
.month-summary > view { flex: 1; border-right: 1rpx solid #dfdfd4; padding-left: 24rpx; }
.month-summary > view:first-child { padding-left: 8rpx; }
.month-summary > view:last-child { border: none; }
.summary-value { font-size: 44rpx; font-weight: 600; color: #365c48; font-variant-numeric: tabular-nums; }
.summary-value text { font-size: 21rpx; font-weight: 400; margin-left: 8rpx; color: #777f73; }
.summary-label { font-size: 21rpx; color: #85897e; margin-top: 8rpx; }
.calendar-panel { background: #fffefa; border: 1rpx solid #e5e5da; border-radius: 28rpx; padding: 26rpx 16rpx 22rpx; }
.calendar-heading { display: flex; align-items: center; justify-content: space-between; padding: 0 12rpx 26rpx; }
.month-title { font-size: 25rpx; color: #91968b; white-space: nowrap; }
.month-title text { margin-left: 14rpx; color: #344b3b; font-size: 34rpx; font-weight: 600; }
.month-title .month-caret { font-size: 22rpx; font-weight: 400; }
.calendar-controls { display: flex; align-items: center; gap: 6rpx; }
.calendar-controls button { padding: 0; width: 56rpx; line-height: 60rpx; background: transparent; font-size: 38rpx; }
.calendar-controls .back-today { width: 70rpx; font-size: 22rpx; }
.calendar-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); color: #959b90; font-size: 21rpx; text-align: center; padding-bottom: 14rpx; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8rpx 3rpx; }
.calendar-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-width: 0; height: 108rpx; margin: 0; padding: 8rpx 0; box-sizing: border-box; background: transparent; border-radius: 18rpx; line-height: 1.3; color: #364538; }
.calendar-day { font-size: 28rpx; font-weight: 500; position: relative; }
.calendar-duration { min-height: 25rpx; margin-top: 6rpx; font-size: 18rpx; color: #8b9285; }
.state-dot { display: inline-block; width: 8rpx; height: 8rpx; border-radius: 50%; flex-shrink: 0; background: transparent; }
.calendar-cell .state-dot { margin-top: 5rpx; }
.qualified { background: #508265; }
.unqualified { background: #c78863; }
.pending { background: #c8ba81; }
.calendar-cell.selected { background: #386552; color: white; }
.calendar-cell.selected .calendar-duration { color: #e4ecdf; }
.calendar-cell.selected .qualified { background: #c4e5b8; }
.calendar-cell.selected .unqualified { background: #ffba92; }
.calendar-cell.selected .pending { background: #ead690; }
.calendar-cell.outside, .calendar-cell[disabled] { color: #d4d5cb; background: transparent; }
.calendar-cell.future { color: #acb0a5; }
.calendar-cell.future.selected { color: white; }
.today-mark { position: absolute; right: -11rpx; top: 0; width: 6rpx; height: 6rpx; background: #558164; border-radius: 50%; }
.selected .today-mark { background: white; }
.calendar-legend { display: flex; justify-content: center; flex-wrap: wrap; gap: 20rpx; border-top: 1rpx solid #eff0e8; margin: 22rpx 10rpx 0; padding-top: 20rpx; font-size: 19rpx; color: #93988e; }
.calendar-legend > view { display: flex; align-items: center; gap: 8rpx; }
.day-panel { margin-top: 24rpx; background: #fffefa; border: 1rpx solid #e5e5da; border-radius: 24rpx; padding: 28rpx; }
.selected-title { font-weight: 600; font-size: 29rpx; }
.selected-duration { font-size: 36rpx; margin-top: 18rpx; color: #386552; }
.punch-heading { border-top: 1rpx solid #edf0e5; margin-top: 24rpx; padding-top: 20rpx; font-size: 24rpx; color: #737f6d; }
.detail-note { padding: 24rpx 0 4rpx; font-size: 23rpx; line-height: 1.8; color: #90968b; }
.timeline-row { display: flex; gap: 18rpx; position: relative; padding: 26rpx 0 0; }
.timeline-dot { flex-shrink: 0; width: 10rpx; height: 10rpx; border-radius: 50%; background: #a3b996; margin-top: 12rpx; }
.timeline-time { font-size: 27rpx; font-weight: 500; min-width: 124rpx; color: #365c48; font-variant-numeric: tabular-nums; }
.timeline-content { font-size: 26rpx; flex: 1; min-width: 0; }
.calendar-footnote { font-size: 20rpx; line-height: 1.8; color: #969a90; margin: 24rpx 10rpx 0; }
/* Override WeChat's default button width and margins inside the calendar. */
.calendar-grid { display: flex; flex-wrap: wrap; gap: 0; }
.calendar-cell { flex: 0 0 14.285714%; width: 14.285714% !important; max-width: 14.285714% !important; min-width: 0 !important; margin: 0 0 8rpx !important; padding: 8rpx 0 !important; }
.calendar-controls button { min-width: 0 !important; margin: 0 !important; padding: 0 !important; }
.sync-button { min-width: 0 !important; width: auto !important; margin: 0 !important; }
.calendar-cell { position: relative; }
.holiday-mark { position: absolute; top: 3rpx; right: 5rpx; font-size: 16rpx; line-height: 22rpx; color: #a66b4f; }
.holiday-mark.work { color: #707d94; }
.personal-mark { position: absolute; top: 3rpx; left: 5rpx; font-size: 16rpx; line-height: 22rpx; color: #687e5f; }
.selected .holiday-mark, .selected .personal-mark { color: #f4e5bc; }
.day-context { padding: 10rpx 0; color: #7d785f; font-size: 23rpx; line-height: 1.6; }
.school-progress { background: #fffefa; border: 1rpx solid #e5e5da; border-radius: 24rpx; padding: 24rpx 28rpx; margin-top: 24rpx; }
.progress-number { font-size: 46rpx; font-weight: 600; color: #386552; margin: 16rpx 0; }
.progress-number text { font-size: 26rpx; color: #90968b; font-weight: 400; }
.school-progress .track { margin: 16rpx 0; }
.anomaly-panel { padding: 24rpx; background: #f6e7d5; border-radius: 20rpx; margin-top: 24rpx; font-size: 25rpx; }
.anomaly-row { padding-top: 20rpx; font-size: 23rpx; }
