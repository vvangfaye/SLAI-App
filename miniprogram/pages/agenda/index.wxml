<view class="page">
  <view class="row"><view class="title">个人日程</view><button class="small" bindtap="add">添加</button></view>
  <view class="subtitle">本机保存 · 在日历中显示</view>
  <view wx:if="{{editing}}" class="card editor"><form bindsubmit="save">
    <view class="field"><input name="title" bindinput="titleInput" value="{{title}}" maxlength="80" placeholder="考试、作业截止、组会…" /></view>
    <view class="field"><picker mode="date" start="2000-01-01" end="2099-12-31" value="{{date}}" data-field="date" bindchange="change"><view class="picker-value">{{date}} ⌄</view></picker></view>
    <view class="row field"><text>指定时间</text><switch checked="{{timed}}" color="#386552" data-field="timed" bindchange="change" /></view>
    <picker wx:if="{{timed}}" mode="time" value="{{time}}" data-field="time" bindchange="change"><view class="picker-value">{{time}} ⌄</view></picker>
    <view class="actions"><button bindtap="cancel">取消</button><button form-type="submit" class="primary">保存</button></view>
  </form></view>
  <view wx:if="{{status}}" class="notice">{{status}}</view>
  <view class="row section"><text>{{showDone ? '已完成' : '待办日程'}}</text><button class="small" bindtap="filter">{{showDone ? '查看待办' : '查看已完成'}}</button></view>
  <view wx:for="{{rows}}" wx:key="id" class="card"><view data-id="{{item.id}}" bindtap="edit"><view class="course-title">{{item.title}}</view><view class="muted">{{item.date}} {{item.time || '全天'}}</view></view><view class="actions"><button class="small" data-id="{{item.id}}" bindtap="toggle">{{item.done ? '恢复待办' : '标为完成'}}</button></view></view>
  <view wx:if="{{!rows.length}}" class="empty">暂无{{showDone ? '已完成' : '待办'}}日程</view>
</view>
